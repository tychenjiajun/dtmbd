[Unit]
Description=DTMB USB stick → IPTV over the LAN
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dtmbd
Group=dtmbd
StateDirectory=dtmbd
ExecStart=/usr/local/bin/dtmbd serve --bind 0.0.0.0:8080 \
    --table /var/lib/dtmbd/channels.json \
    --names /etc/dtmbd/names.json
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
