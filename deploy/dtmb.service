[Unit]
Description=DTMB USB stick → IPTV over the LAN
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dtmb
Group=dtmb
StateDirectory=dtmb
ExecStart=/usr/local/bin/dtmb serve --bind 0.0.0.0:8080 \
    --table /var/lib/dtmb/channels.json \
    --names /etc/dtmb/names.json
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
